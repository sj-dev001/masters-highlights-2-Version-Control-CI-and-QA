{
  "name": "version-control-ci-qa-student-project",
  "version": "1.0.0",
  "description": "Beginner-friendly project for teaching Git, GitHub Actions, testing, linting, and QA.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "education",
    "git",
    "github-actions",
    "qa",
    "jest",
    "eslint"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "jest": "^29.7.0",
    "vite": "^6.3.5"
  }
}
